# Resend Configuration
RESEND_API_KEY=re_YourApiKey_Here
MAIL_TO=you@example.com
MAIL_FROM=Stella · Cosmic Digest <digest@yourdomain.com>
RESEND_VERIFY_DELIVERY=true

# Sender identity shown inside the email. Host the selected avatar publicly.
BRAND_NAME=Stella · Cosmic Digest
BRAND_AVATAR_URL=https://raw.githubusercontent.com/NaxeCode/Cosmic-Digest/main/assets/brand/stella-avatar-128.png

# Timezone for email timestamps (IANA timezone name)
# Examples: America/New_York, America/Los_Angeles, America/Chicago, Europe/London
TIMEZONE=America/New_York

# OpenAI Configuration (optional - only needed if ENABLE_AI_SUMMARY=true)
OPENAI_API_KEY=your_openai_api_key_here
ENABLE_AI_SUMMARY=false
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# Preferred personalization: load a versioned profile locally, or store its
# base64-encoded JSON in the DIGEST_PROFILE_B64 GitHub Actions secret.
# DIGEST_PROFILE_PATH=config/briefing-profile.example.json
# DIGEST_PROFILE_B64=

# Optional signed feedback links. Both are required before controls appear.
# FEEDBACK_BASE_URL=https://feedback.yourdomain.com/feedback
# FEEDBACK_SIGNING_KEY=generate-a-long-random-secret

# Personalization (CSV lists)
PREF_TOPICS=ai,hardware,gaming,geopolitics,macroeconomy
PREF_REGIONS=US,EU,Middle East,Asia
PREF_KEYWORDS=AMD,NVIDIA,Intel,GPU,CPU,SSD

# RSS Feeds (comma-separated)
RSS_FEEDS=https://openai.com/news/rss.xml,https://github.blog/changelog/feed/,https://devblogs.microsoft.com/dotnet/feed/

# Optional feedback API configuration (see feedback/CosmicDigest.Feedback.Api)
# FEEDBACK_DATA_DIR=/data
# FEEDBACK_ADMIN_TOKEN=generate-a-long-random-secret
# RESEND_WEBHOOK_SECRET=whsec_xxxxx
