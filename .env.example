# Resend Configuration
RESEND_API_KEY=re_YourApiKey_Here
MAIL_TO=you@example.com
MAIL_FROM=digest@yourdomain.com

# Timezone for email timestamps (IANA timezone name)
# Examples: America/New_York, America/Los_Angeles, America/Chicago, Europe/London
TIMEZONE=America/New_York

# OpenAI Configuration (optional - only needed if ENABLE_AI_SUMMARY=true)
OPENAI_API_KEY=your_openai_api_key_here
ENABLE_AI_SUMMARY=false
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# Preferred personalization: load a versioned profile locally, or store its
# base64-encoded JSON in the DIGEST_PROFILE_B64 GitHub Actions secret.
# DIGEST_PROFILE_PATH=config/briefing-profile.example.json
# DIGEST_PROFILE_B64=

# Personalization (CSV lists)
PREF_TOPICS=ai,hardware,gaming,geopolitics,macroeconomy
PREF_REGIONS=US,EU,Middle East,Asia
PREF_KEYWORDS=AMD,NVIDIA,Intel,GPU,CPU,SSD

# RSS Feeds (comma-separated)
RSS_FEEDS=https://feeds.bbci.co.uk/news/rss.xml,https://www.reuters.com/rssFeed/worldNews,https://www.theverge.com/rss/index.xml
